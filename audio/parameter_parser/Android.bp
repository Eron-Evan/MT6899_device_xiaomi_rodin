cc_binary {
    name: "android.hardware.audio.parameter_parser.service",
    system_ext_specific: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.audio.parameter_parser.service.rc"],
    defaults: ["android.hardware.audio.parameter_parser.example_defaults"],
    srcs: [
        "ParameterParser.cpp",
        "main.cpp",
    ],
}
